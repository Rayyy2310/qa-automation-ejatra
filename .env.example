#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = ejatra_testing
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port     = 3306

#--------------------------------------------------------------------
# LLM PROVIDERS — Isi API Key sesuai kebutuhan
#--------------------------------------------------------------------

# Groq Cloud (Cepat & Gratis: https://console.groq.com/keys)
GROQ_API_KEY = your_groq_api_key_here
GROQ_MODEL = openai/gpt-oss-20b
GROQ_DEFAULT_MODEL = groq/compound-mini

# Google Gemini (Dapatkan di: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY = your_gemini_api_key_here
GEMINI_MODEL = gemini-1.5-flash
GEMINI_DEFAULT_MODEL = gemini-2.0-flash

# OpenAI (Opsional)
OPENAI_API_KEY = ''
OPENAI_DEFAULT_MODEL = 'gpt-4o-mini'

# Anthropic Claude (Opsional)
CLAUDE_API_KEY = ''
CLAUDE_DEFAULT_MODEL = 'claude-sonnet-4-20250514'
CLAUDE_CLI_ENABLED = true

# Ollama Local LLM (Opsional)
OLLAMA_BASE_URL = 'http://localhost:11434'
OLLAMA_DEFAULT_MODEL = 'llama3'

#--------------------------------------------------------------------
# NODE.JS PLAYWRIGHT TEST SERVICE
#--------------------------------------------------------------------

TEST_SERVICE_URL = 'http://localhost:3001'
INTERNAL_API_TOKEN = your_secure_internal_token_here

#--------------------------------------------------------------------
# TARGET WEB & TEST CREDENTIALS
#--------------------------------------------------------------------

EJATRA_TESTING_BASE_URL = 'http://localhost/e-jatra/'
EJATRA_TEST_USERNAME = 'test_user'
EJATRA_TEST_PASSWORD = 'test_password'
MAX_CONCURRENT_RUNS = 4

